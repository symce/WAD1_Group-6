# Apache / XAMPP protection (the PHP built-in server uses router.php instead).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Private folders
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(database|config|includes|storage)(/|$) - [F,L]
</IfModule>

# Sensitive files
<FilesMatch "(?i)(\.(sql|sqlite|sqlite3|db|log|md)|^\.[^/]*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
